<UserControl x:Class="PhotosViewer.WorldMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Border CornerRadius="12" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                Background="#E8EEF4" ClipToBounds="True">
            <Grid>
                <Grid x:Name="MapHost" Background="#C8D9E8"
                      ClipToBounds="True"
                      MouseWheel="MapHost_OnMouseWheel"
                      MouseLeftButtonDown="MapHost_OnMouseDown"
                      MouseMove="MapHost_OnMouseMove"
                      MouseLeftButtonUp="MapHost_OnMouseUp"
                      MouseLeave="MapHost_OnMouseLeave">
                    <Canvas x:Name="TileCanvas" IsHitTestVisible="False"/>
                    <Canvas x:Name="PinsCanvas" IsHitTestVisible="True"/>
                </Grid>

                <TextBlock x:Name="EmptyHint"
                           Text="Nessuna foto o video con posizione"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"/>

                <!-- Zoom +/- (stile Leaflet) -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                            IsHitTestVisible="True">
                    <Button x:Name="ZoomInBtn" Content="+" Width="32" Height="32" Margin="0,0,0,4"
                            FontSize="18" FontWeight="SemiBold" Padding="0"
                            Click="ZoomInBtn_OnClick"
                            Background="#EEFFFFFF" BorderBrush="{StaticResource HairlineBrush}"/>
                    <Button x:Name="ZoomOutBtn" Content="−" Width="32" Height="32"
                            FontSize="18" FontWeight="SemiBold" Padding="0"
                            Click="ZoomOutBtn_OnClick"
                            Background="#EEFFFFFF" BorderBrush="{StaticResource HairlineBrush}"/>
                </StackPanel>

                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="12" Background="#CCFFFFFF" CornerRadius="8" Padding="10,6"
                        IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock x:Name="StatusHint"
                                   FontFamily="{StaticResource BodyFont}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="AttributionText"
                                   FontFamily="{StaticResource BodyFont}" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                   TextWrapping="Wrap" MaxWidth="280"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
