<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PhotosViewer</AssemblyName>
    <RootNamespace>PhotosViewer</RootNamespace>
    <ApplicationTitle>Libreria</ApplicationTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ThumbBench" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.6" />
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
    <PackageReference Include="Openize.HEIC" Version="25.12.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\iCloudKitExtractor\Assets\app-icon.ico" Link="Assets\app-icon.ico" Condition="Exists('..\iCloudKitExtractor\Assets\app-icon.ico')" />
  </ItemGroup>
</Project>
