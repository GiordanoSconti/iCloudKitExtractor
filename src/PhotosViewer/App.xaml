<Application x:Class="PhotosViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette ispirata a iCloud.com / Foto Apple -->
            <Color x:Key="Ink">#1D1D1F</Color>
            <Color x:Key="Muted">#86868B</Color>
            <Color x:Key="Paper">#FFFFFF</Color>
            <Color x:Key="Canvas">#F5F5F7</Color>
            <Color x:Key="Sidebar">#FBFBFD</Color>
            <Color x:Key="Line">#D2D2D7</Color>
            <Color x:Key="Hairline">#E8E8ED</Color>
            <Color x:Key="Accent">#0071E3</Color>
            <Color x:Key="AccentSoft">#E8F1FC</Color>
            <Color x:Key="Selection">#0071E3</Color>
            <Color x:Key="MapOcean">#A8C7E0</Color>

            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
            <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Paper}"/>
            <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Canvas}"/>
            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource Sidebar}"/>
            <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}"/>
            <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}"/>
            <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource Selection}"/>
            <SolidColorBrush x:Key="SageBrush" Color="{StaticResource Accent}"/>
            <SolidColorBrush x:Key="StudioBackground" Color="{StaticResource Canvas}"/>

            <!-- Closest SF Pro stand-in on Windows -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>

            <Style x:Key="ICloudCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="ICloudDate" TargetType="DatePicker">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Margin" Value="12,16,12,6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
