<UserControl x:Class="BackupViewer.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:BackupViewer.Models">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="200"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
            <TextBlock x:Name="ListHeader" DockPanel.Dock="Top" Margin="12,12,12,8"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}" Text="CONTATTI"/>
            <ListBox x:Name="ContactList" BorderThickness="0" Background="Transparent"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     SelectionChanged="ContactList_OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ContactRecord}">
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PhonesSummary}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Organization}" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource CanvasBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <ScrollViewer Grid.Column="2" Background="{StaticResource PaperBrush}" Padding="20"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DetailPanel">
                <TextBlock x:Name="NameText" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="OrgText" Margin="0,4,0,0" FontSize="13"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="JobText" Margin="0,2,0,12" FontSize="12"
                           Foreground="{StaticResource MutedBrush}"/>

                <TextBlock Text="Telefoni" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                <ItemsControl x:Name="PhoneList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ContactField}">
                            <DockPanel Margin="0,3">
                                <TextBlock Text="{Binding Label}" Width="100"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource InkBrush}"
                                           FontSize="13" TextWrapping="Wrap"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Email" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,16,0,4"/>
                <ItemsControl x:Name="EmailList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ContactField}">
                            <DockPanel Margin="0,3">
                                <TextBlock Text="{Binding Label}" Width="100"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource InkBrush}"
                                           FontSize="13" TextWrapping="Wrap"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Altro" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,16,0,4"/>
                <ItemsControl x:Name="OtherList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ContactField}">
                            <DockPanel Margin="0,3">
                                <TextBlock Text="{Binding Label}" Width="100"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource InkBrush}"
                                           FontSize="13" TextWrapping="Wrap"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Note" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,16,0,4"/>
                <TextBlock x:Name="NoteText" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource InkBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
