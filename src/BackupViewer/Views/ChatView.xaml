<UserControl x:Class="BackupViewer.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:BackupViewer.Models">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" MinWidth="120"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="240" MinWidth="160"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*" MinWidth="220"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="320" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
            <TextBlock DockPanel.Dock="Top" Margin="12,12,12,8"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}" Text="APP"/>
            <ListBox x:Name="AppList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="AppList_OnSelectionChanged"
                     DisplayMemberPath="Title"/>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource CanvasBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <DockPanel Grid.Column="2" Background="{StaticResource PaperBrush}">
            <TextBlock x:Name="ThreadHeader" DockPanel.Dock="Top" Margin="12,12,12,8"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}" Text="CONVERSAZIONI"/>
            <ListBox x:Name="ThreadList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     SelectionChanged="ThreadList_OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ChatConversation}">
                        <StackPanel Margin="4,6">
                            <DockPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding LastDate, StringFormat={}{0:dd/MM HH:mm}}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding LastPreview}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding MessageCount, Mode=OneWay}"/>
                                <Run Text=" msg"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource CanvasBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <DockPanel Grid.Column="4" Background="{StaticResource CanvasBrush}">
            <Border DockPanel.Dock="Top" Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                <DockPanel>
                    <TextBlock x:Name="ChatTitle" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" Text="Seleziona una conversazione"/>
                    <ComboBox x:Name="KindFilter" DockPanel.Dock="Right" Width="140" Height="28"
                              SelectedIndex="0"
                              SelectionChanged="KindFilter_OnSelectionChanged">
                        <ComboBoxItem Content="Tutti" Tag=""/>
                        <ComboBoxItem Content="Inviati" Tag="Sent"/>
                        <ComboBoxItem Content="Ricevuti" Tag="Received"/>
                        <ComboBoxItem Content="Stato" Tag="Status"/>
                        <ComboBoxItem Content="Sistema" Tag="System"/>
                        <ComboBoxItem Content="Eliminati" Tag="Deleted"/>
                    </ComboBox>
                </DockPanel>
            </Border>
            <TextBlock x:Name="ChatEmpty" Text="Nessun messaggio."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
            <ListBox x:Name="MessageList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="MessageList_OnMouseDoubleClick"
                     SelectionChanged="MessageList_OnSelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ChatMessage}">
                        <Grid Margin="14,3">
                            <Border x:Name="Bubble" MaxWidth="520" Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource PanelBrush}"
                                    CornerRadius="18,18,18,4">
                                <StackPanel>
                                    <TextBlock x:Name="Sender" Text="{Binding SenderLabel}" FontSize="11"
                                               FontWeight="SemiBold" Margin="0,0,0,2"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="BodyText" Text="{Binding Body}" TextWrapping="Wrap"
                                               Foreground="{StaticResource InkBrush}" FontSize="14"/>
                                    <Border x:Name="MediaChip" Margin="0,6,0,0" Padding="8,6"
                                            Background="{StaticResource PaperBrush}"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            Visibility="Collapsed">
                                        <TextBlock Text="{Binding MediaLabel}" FontSize="11"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock x:Name="TimeText" Margin="0,4,0,0" FontSize="10"
                                               Foreground="{StaticResource SubtleBrush}"
                                               Text="{Binding SentAt, StringFormat={}{0:HH:mm}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Sent">
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Bubble" Property="Background" Value="{StaticResource IMessageBrush}"/>
                                <Setter TargetName="Bubble" Property="CornerRadius" Value="18,18,4,18"/>
                                <Setter TargetName="Sender" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="BodyText" Property="Foreground" Value="White"/>
                                <Setter TargetName="TimeText" Property="Foreground" Value="#CCFFFFFF"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Received">
                                <Setter TargetName="Bubble" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="System">
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="Bubble" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Bubble" Property="MaxWidth" Value="420"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Status">
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="Bubble" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Deleted">
                                <Setter TargetName="Bubble" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="Bubble" Property="Opacity" Value="0.9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SenderLabel}" Value="">
                                <Setter TargetName="Sender" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MediaLabel}" Value="">
                                <Setter TargetName="MediaChip" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MediaKind}" Value="Image">
                                <Setter TargetName="MediaChip" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MediaKind}" Value="Video">
                                <Setter TargetName="MediaChip" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MediaKind}" Value="Audio">
                                <Setter TargetName="MediaChip" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MediaKind}" Value="Document">
                                <Setter TargetName="MediaChip" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="5" Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource CanvasBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <DockPanel Grid.Column="6" Background="{StaticResource PanelBrush}">
            <TextBlock DockPanel.Dock="Top" Margin="12,12,12,8"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}" Text="MEDIA"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="12,8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Play" Style="{StaticResource ToolButton}" Click="MediaPlay_OnClick"/>
                    <Button Content="Stop" Style="{StaticResource ToolButton}" Click="MediaStop_OnClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Salva come…" Style="{StaticResource ToolButton}" Click="MediaSave_OnClick"/>
                    <Button Content="Apri file" Style="{StaticResource ToolButton}" Click="MediaOpen_OnClick"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="MediaInfo" DockPanel.Dock="Top" Margin="12,0,12,8"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource InkBrush}"
                       Text="Seleziona un messaggio con allegato."/>
            <Grid Margin="8">
                <Image x:Name="MediaImage" Stretch="Uniform" Visibility="Collapsed"/>
                <Border x:Name="MediaVlcHost" Background="#0F172A" Visibility="Collapsed"/>
                <TextBlock x:Name="MediaEmpty"
                           Text="Nessuna anteprima."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
