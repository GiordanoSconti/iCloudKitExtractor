<UserControl x:Class="BackupViewer.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:BackupViewer.Models">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*" MinWidth="280"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="300" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
            <TextBlock DockPanel.Dock="Top" Margin="12,12,12,8"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}" Text="CALENDARI"/>
            <ListBox x:Name="CalendarList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="CalendarList_OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CalendarInfo}">
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                                <Run Text="{Binding EventCount, Mode=OneWay}"/>
                                <Run Text=" eventi"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource CanvasBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <DockPanel Grid.Column="2" Background="{StaticResource PaperBrush}">
            <Border DockPanel.Dock="Top" Padding="12,10"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button Content="‹" Width="32" Style="{StaticResource ToolButton}" Click="PrevMonth_OnClick"/>
                    <TextBlock x:Name="MonthLabel" Margin="8,0"
                               VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"/>
                    <Button DockPanel.Dock="Right" Content="›" Width="32"
                            Style="{StaticResource ToolButton}" Click="NextMonth_OnClick"/>
                    <Button DockPanel.Dock="Right" Content="Oggi" Style="{StaticResource ToolButton}"
                            Click="Today_OnClick"/>
                </DockPanel>
            </Border>
            <UniformGrid x:Name="DayHeaders" DockPanel.Dock="Top" Rows="1" Columns="7" Margin="8,8,8,0"/>
            <UniformGrid x:Name="DayGrid" Rows="6" Columns="7" Margin="8"/>
        </DockPanel>

        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource CanvasBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <DockPanel Grid.Column="4" Background="{StaticResource PanelBrush}">
            <TextBlock x:Name="DayHeader" DockPanel.Dock="Top" Margin="12,12,12,8"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}" Text="EVENTI"/>
            <ListBox x:Name="EventList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="EventList_OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CalendarEventItem}">
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="{Binding WhenLabel}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding CalendarTitle}" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border DockPanel.Dock="Bottom" Padding="12"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Background="{StaticResource PaperBrush}">
                <StackPanel>
                    <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource InkBrush}"/>
                    <TextBlock x:Name="DetailWhen" Margin="0,4,0,0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailLoc" Margin="0,4,0,0" FontSize="12"
                               Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailDesc" Margin="0,8,0,0" FontSize="12"
                               Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
