<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BackupViewer</AssemblyName>
    <RootNamespace>BackupViewer</RootNamespace>
    <ApplicationTitle>Backup Viewer</ApplicationTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.6" />
    <PackageReference Include="Openize.HEIC" Version="25.12.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

  <!--
    Autofirma locale (Release): cert CN=ForensisLab BackupViewer in CurrentUser\My,
    trusted in Root + TrustedPublisher. Skip: -p:SkipLocalSign=true
  -->
  <Target Name="SignLocalRelease"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipLocalSign)' != 'true'">
    <PropertyGroup>
      <_SignScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\scripts\sign_backupviewer.ps1'))</_SignScript>
      <_SignOutDir>$([System.IO.Path]::GetFullPath('$(TargetDir)').TrimEnd('\'))</_SignOutDir>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_SignScript)&quot; -OutputDir &quot;$(_SignOutDir)&quot; -TrustLocally"
          IgnoreExitCode="false"
          LogStandardErrorAsError="true" />
  </Target>
</Project>
