<Window x:Class="iCloudKitExtractor.MessagesChatViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sync="clr-namespace:iCloudKitExtractor.Services.SyncData;assembly=iCloudKitExtractor.Core"
        Title="Messages"
        Height="820" Width="1180"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="#F2F2F7"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="ChatListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="14,10"
                                BorderBrush="#14000000" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A007AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFFF2" BorderBrush="#1A000000" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Messaggi"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#1B1C1F" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SummaryText"
                               Margin="14,0,0,0"
                               FontSize="12" Foreground="#5F6368"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="240" Height="30"
                             VerticalContentAlignment="Center" Padding="10,0"
                             TextChanged="SearchBox_OnTextChanged"
                             ToolTip="Filtra chat e messaggi"/>
                    <Button Content="Ricarica" Margin="10,0,0,0" Padding="12,4"
                            Click="Reload_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFFF8" BorderBrush="#14000000" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="16,12,16,6"
                               FontSize="12" Foreground="#5F6368"
                               Text="Chat"/>
                    <ListBox x:Name="ChatList"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ChatListItem}"
                             SelectionChanged="ChatList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type sync:ChatThread}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="40" Height="40" Fill="#D1D1D6"/>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Initials}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" FontSize="13" Foreground="#3A3A3C"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   FontSize="13" Foreground="#1B1C1F"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Preview}" FontSize="12"
                                                   Foreground="#6B6B70" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding LastTimeDisplay}" FontSize="11"
                                                   Foreground="#8E8E93" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding MessageCount, StringFormat={}{0}}" FontSize="10"
                                                   Foreground="#AEAEB2" Margin="0,4,0,0"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFFF2" BorderBrush="#14000000" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center" Margin="18,0">
                        <TextBlock x:Name="ThreadTitle" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#1B1C1F" Text="Seleziona una chat"/>
                        <TextBlock x:Name="ThreadSubtitle" FontSize="11" Foreground="#8E8E93"/>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="ThreadScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="#F2F2F7"
                              Padding="18,14">
                    <ItemsControl x:Name="MessageList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type sync:ChatMessage}">
                                <Grid Margin="0,3">
                                    <Border x:Name="Bubble"
                                            MaxWidth="520"
                                            Padding="12,8"
                                            CornerRadius="16"
                                            HorizontalAlignment="Left"
                                            Background="#FFFFFF"
                                            BorderBrush="#10000000"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="SenderLabel"
                                                       Text="{Binding SenderLabel}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#007AFF"
                                                       Margin="0,0,0,2"
                                                       Visibility="Collapsed"/>
                                            <Border x:Name="ReplyBox" Background="#14000000"
                                                    CornerRadius="8" Padding="8,4" Margin="0,0,0,6">
                                                <TextBlock x:Name="ReplyLabel"
                                                           Text="{Binding Reply}"
                                                           FontSize="11" FontStyle="Italic"
                                                           Foreground="#6B6B70"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock x:Name="Body"
                                                       Text="{Binding DisplayText}"
                                                       FontSize="14" Foreground="#1B1C1F"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Left"/>
                                            <DockPanel Margin="0,4,0,0">
                                                <TextBlock Text="{Binding AssociatedEmoji}"
                                                           FontSize="12" DockPanel.Dock="Left"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock x:Name="TimeLabel"
                                                           Text="{Binding TimeDisplay}"
                                                           FontSize="10" Foreground="#8E8E93"
                                                           HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFromMe}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="Bubble" Property="Background" Value="#007AFF"/>
                                        <Setter TargetName="Bubble" Property="BorderThickness" Value="0"/>
                                        <Setter TargetName="Body" Property="Foreground" Value="White"/>
                                        <Setter TargetName="TimeLabel" Property="Foreground" Value="#CCFFFFFF"/>
                                        <Setter TargetName="ReplyLabel" Property="Foreground" Value="#E6FFFFFF"/>
                                        <Setter TargetName="ReplyBox" Property="Background" Value="#22FFFFFF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/>
                                        <Setter TargetName="Bubble" Property="Background" Value="Transparent"/>
                                        <Setter TargetName="Bubble" Property="BorderThickness" Value="0"/>
                                        <Setter TargetName="Bubble" Property="MaxWidth" Value="440"/>
                                        <Setter TargetName="Body" Property="Foreground" Value="#6B6B70"/>
                                        <Setter TargetName="Body" Property="FontSize" Value="12"/>
                                        <Setter TargetName="Body" Property="TextAlignment" Value="Center"/>
                                        <Setter TargetName="TimeLabel" Property="HorizontalAlignment" Value="Center"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsFromMe}" Value="False"/>
                                            <Condition Binding="{Binding IsSystem}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="SenderLabel" Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding Reply}" Value="{x:Null}">
                                        <Setter TargetName="ReplyBox" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Reply}" Value="">
                                        <Setter TargetName="ReplyBox" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint" Grid.Row="1"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="#8E8E93"
                           Text="Nessuna chat da mostrare"
                           IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
