<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\native\CoreAdiBridge\out\CoreAdiBridge.exe" Link="CoreAdiBridge.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\native\CoreAdiBridge\out\CoreAdiBridge.exe')" />
    <Resource Include="Assets\app-icon.ico" />
    <Resource Include="Assets\app-icon.png" />
    <EmbeddedResource Include="Assets\certs\AppleServerAuthenticationCA.der" />
    <EmbeddedResource Include="Assets\certs\AppleRootCA.cer" />
    <EmbeddedResource Include="Assets\ike\wsc_preauth_session_prefix.bin" />
    <EmbeddedResource Include="Assets\ike\wsc_prefix_frame1.bin" />
    <EmbeddedResource Include="Assets\ike\wsc_prefix_frame2_template.bin" />
    <EmbeddedResource Include="Assets\ike\wsc_session_blob_header.bin" />
    <EmbeddedResource Include="Assets\ike\wsc_session_unit_template.bin" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="LzfseSharp" Version="2.0.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.6" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <!-- Override transitive 2.1.x (NU1903 GHSA-2m69-gcr7-jv3q); 3.x usa SourceGear.sqlite3 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!-- Payload visualizzatore portatile (photos/Viewer) -->
  <Target Name="BuildPhotosViewerPayload" AfterTargets="Build">
    <MSBuild Projects="..\PhotosViewer\PhotosViewer.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration)" ContinueOnError="true" />
    <ItemGroup>
      <_ViewerOut Include="..\PhotosViewer\bin\$(Configuration)\net10.0-windows\**\*" Exclude="..\PhotosViewer\bin\$(Configuration)\net10.0-windows\**\*.pdb" />
    </ItemGroup>
    <RemoveDir Directories="$(OutputPath)viewer-payload" Condition="Exists('$(OutputPath)viewer-payload')" />
    <MakeDir Directories="$(OutputPath)viewer-payload" />
    <Copy SourceFiles="@(_ViewerOut)" DestinationFiles="@(_ViewerOut->'$(OutputPath)viewer-payload\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_ViewerOut)' != ''" />
  </Target>

  <!--
    Autofirma locale (Release): cert CN=ForensisLab iCloudKitExtractor in CurrentUser\My,
    trusted in Root + TrustedPublisher. Skip: -p:SkipLocalSign=true
  -->
  <Target Name="SignLocalRelease"
          AfterTargets="BuildPhotosViewerPayload"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipLocalSign)' != 'true'">
    <PropertyGroup>
      <_SignScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\scripts\sign_icloudkitextractor.ps1'))</_SignScript>
      <!-- Trim trailing \ so PowerShell does not eat the closing quote. -->
      <_SignOutDir>$([System.IO.Path]::GetFullPath('$(TargetDir)').TrimEnd('\'))</_SignOutDir>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_SignScript)&quot; -OutputDir &quot;$(_SignOutDir)&quot; -TrustLocally"
          IgnoreExitCode="false"
          LogStandardErrorAsError="true" />
  </Target>

</Project>
