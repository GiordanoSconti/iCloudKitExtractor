                                                        Grid.Column="3"
                                                        ToolTip="Sent date (inclusive) — leave empty for no limit"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Keywords"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="ImapFilterKeywordsTextBox"
                                                     Grid.Column="1"
                                                     VerticalContentAlignment="Center"
                                                     IsEnabled="False"
                                                     ToolTip="Space-separated tokens (AND) on subject, sender, and body"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button x:Name="ImapFilterApplyButton"
                                                        Content="Apply"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        MinWidth="80" Margin="0,0,6,0"
