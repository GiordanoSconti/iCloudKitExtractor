<Window x:Class="iCloudKitExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iCloudKit Extractor" Height="720" Width="1280"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Background="{StaticResource MeshBackgroundBrush}"
        SizeChanged="MainWindow_SizeChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Soft Gemini-like color blobs (positions updated on resize) -->
        <Canvas x:Name="BackgroundBlobCanvas" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="BlobA" Width="420" Height="420" Canvas.Left="-80" Canvas.Top="-120" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#994285F4" Offset="0"/>
                        <GradientStop Color="#004285F4" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="BlobB" Width="380" Height="380" Canvas.Left="780" Canvas.Top="20" Opacity="0.45">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#99A855F7" Offset="0"/>
                        <GradientStop Color="#00A855F7" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="BlobC" Width="460" Height="320" Canvas.Left="240" Canvas.Top="480" Opacity="0.40">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#88FB7185" Offset="0"/>
                        <GradientStop Color="#00FB7185" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="BlobD" Width="300" Height="300" Canvas.Left="620" Canvas.Top="380" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7734D399" Offset="0"/>
                        <GradientStop Color="#0034D399" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid x:Name="RootContentGrid" Margin="16,16,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="10" Margin="0,0,16,0"
                            ClipToBounds="True"
                            Effect="{StaticResource SoftShadow}">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/app-icon.png"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="HeaderTitleText" Text="iCloud Backup Extractor" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock x:Name="HeaderSubtitleText" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0"
                                   Text="Login Apple ID · Escrow PCS · Backup download · WhatsApp CloudKit · iCloud Files · Sync Data"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource SessionChipStyle}" VerticalAlignment="Center"
                            MaxWidth="280">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SessionIndicator" Width="10" Height="10" Fill="{StaticResource IdleBrush}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SessionStatusText" VerticalAlignment="Center"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentABrush}"
                                       TextWrapping="Wrap"
                                       Text="Not authenticated"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Wide: tabs | side. Narrow: tabs above, session panel below. -->
            <Grid x:Name="WorkAreaGrid" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="WorkTabsRow" Height="*"/>
                    <RowDefinition x:Name="WorkStackGapRow" Height="0"/>
                    <RowDefinition x:Name="WorkSideRow" Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="WorkTabsCol" Width="*" MinWidth="420"/>
                    <ColumnDefinition x:Name="WorkGapCol" Width="12"/>
                    <ColumnDefinition x:Name="WorkSideCol" Width="320" MinWidth="240" MaxWidth="420"/>
                </Grid.ColumnDefinitions>

            <TabControl x:Name="MainTabControl" Grid.Row="0" Grid.Column="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <!-- Accesso -->
                <TabItem x:Name="AccessTab" Header="Sign in">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Apple ID credentials" Style="{StaticResource SectionLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Apple ID" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="AppleIdTextBox" Grid.Column="1" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Row="1" Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Server Anisette" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock x:Name="AnisetteEnvOverrideText"
                                           Text="ANISETTE_SERVER_URL is set: takes priority over the UI."
                                           Foreground="#B58600" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="AnisetteLocalRadio" Content="Local (127.0.0.1:6971)"
                                                 IsChecked="True" GroupName="AnisetteServerMode"
                                                 Margin="0,0,16,0"
                                                 Checked="AnisetteServerModeRadio_Changed"/>
                                    <RadioButton x:Name="AnisetteRemoteRadio" Content="Remote server"
                                                 GroupName="AnisetteServerMode"
                                                 Checked="AnisetteServerModeRadio_Changed"/>
                                </StackPanel>
                                <Grid x:Name="AnisetteRemoteFieldsPanel" IsEnabled="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="URL" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="AnisetteServerUrlTextBox" Grid.Column="1" Margin="0,0,0,8"
                                             ToolTip="E.g. http://192.168.1.50:6969"/>
                                    <TextBlock Grid.Row="1" Text="Auth mode" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="AnisetteAuthModeCombo" Grid.Row="1" Grid.Column="1"
                                              Margin="0,0,0,8" Width="160" HorizontalAlignment="Left"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="iphone" Tag="iphone" IsSelected="True"/>
                                        <ComboBoxItem Content="hybrid" Tag="hybrid"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Text="License" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="AnisetteLicenseTextBox" Grid.Row="2" Grid.Column="1"
                                             ToolTip="Optional: Bearer token or path to a .license file (Licensed server)"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="AnisetteTestButton" Content="Test connection"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="132" Margin="0,0,8,0"
                                            Click="AnisetteTestButton_Click"/>
                                    <Button x:Name="AnisetteSaveButton" Content="Save Anisette"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="132"
                                            Click="AnisetteSaveButton_Click"/>
                                    <TextBlock x:Name="AnisetteSettingsStatusText"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="LoginButton" Content="Sign in"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="132" Click="LoginButton_Click"/>
                        </StackPanel>

                        <Border x:Name="TwoFactorPanel" Grid.Row="3" Style="{StaticResource SectionCardStyle}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Two-factor verification" Style="{StaticResource SectionLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="TwoFactorDeviceRadio" Content="Trusted device"
                                                 IsChecked="True" GroupName="TwoFactorMethod"
                                                 Checked="TwoFactorMethodRadio_Changed"/>
                                    <RadioButton x:Name="TwoFactorSmsRadio" Content="SMS"
                                                 GroupName="TwoFactorMethod"
                                                 Checked="TwoFactorMethodRadio_Changed"/>
                                </StackPanel>
                                <StackPanel x:Name="SmsPhonePanel" Orientation="Horizontal" Margin="0,0,0,10"
                                            Visibility="Collapsed">
                                    <ComboBox x:Name="SmsPhoneComboBox" Width="240" Margin="0,0,10,0"
                                              DisplayMemberPath="DisplayLabel"/>
                                    <Button x:Name="RequestSmsButton" Content="Send SMS"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RequestSmsButton_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TwoFactorCodeTextBox" Width="140" Margin="0,0,10,0"/>
                                    <Button x:Name="Verify2FaButton" Content="Submit code"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="Verify2FaButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource LogSectionCardStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Authentication log"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="AuthLogTextBox" Style="{StaticResource LogTextBoxStyle}"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Escrow -->
                <TabItem x:Name="EscrowTab" Header="Escrow KeyBagKey" IsEnabled="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Controlli più alti del log; ScrollViewer funziona solo con altezza vincolata (*). -->
                            <RowDefinition Height="3*" MinHeight="240"/>
                            <RowDefinition Height="2*" MinHeight="140"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          CanContentScroll="False"
                                          Padding="0,0,4,0">
                            <StackPanel MinWidth="520">
                                <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,14"
                                           Text="PCS: Unlock EscrowedKeys (empty iCSC = DSID). Octagon: passcode bottle (HSM) or Recovery Key → TLK/Manatee/PCS (no HSM attempt)."/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*" MinWidth="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Output folder" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="DecryptOutputTextBox" Grid.Column="1" Margin="0,0,10,0"
                                             MinWidth="140" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseDecryptOutput_Click"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*" MinWidth="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="EscrowSecretLabel" Text="iCSC / passcode"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox x:Name="EscrowPasswordBox" Grid.Column="1" Margin="0,0,12,0"
                                                 MinWidth="140" HorizontalAlignment="Stretch"/>
                                    <TextBlock x:Name="EscrowSecretHint" Grid.Column="2"
                                               Text="(PCS SRP=DSID · Octagon bottle: passcode device)"
                                               Style="{StaticResource HintTextStyle}"
                                               TextWrapping="Wrap" MaxWidth="280"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Recovery Key"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox x:Name="EscrowRecoveryKeyBox" Grid.Column="1" Margin="0,0,12,0"
                                                 MinWidth="120" HorizontalAlignment="Stretch"
                                                 ToolTip="iCloud Recovery Key (XXXX-XXXX-…). Octagon alternative to PIN bottle."/>
                                    <TextBlock Grid.Column="2" Text="altDSID"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="EscrowRecoverySaltBox" Grid.Column="3"
                                             MinWidth="100" HorizontalAlignment="Stretch"
                                             ToolTip="Salt HKDF = altDSID/adsid (always from session after login)"/>
                                </Grid>
                                <WrapPanel Margin="0,0,0,14">
                                    <CheckBox x:Name="EscrowSmsVariantCheckBox" Content="SMS variant (securebackup)"
                                              VerticalAlignment="Center" Margin="0,4,12,4"
                                              Checked="EscrowSmsVariantCheckBox_Changed"
                                              Unchecked="EscrowSmsVariantCheckBox_Changed"/>
                                    <TextBlock x:Name="EscrowSmsCodeLabel" Text="SMS code"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,4,8,4" Visibility="Collapsed"/>
                                    <TextBox x:Name="EscrowSmsCodeBox" Width="120" Margin="0,4,12,4" Visibility="Collapsed"/>
                                    <CheckBox x:Name="EscrowRequestSmsCheckBox" Content="Send SMS if code is missing"
                                              Margin="0,4,0,4" VerticalAlignment="Center"
                                              Visibility="Collapsed" IsChecked="True"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button x:Name="EscrowPcsUnlockButton" Content="Unlock EscrowedKeys"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="180" Margin="0,0,8,8"
                                            Click="EscrowPcsUnlockButton_Click"/>
                                </WrapPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="160"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="EscrowOctagonListButton" Content="List iCDP bottles"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="140" Margin="0,0,12,0"
                                            Click="EscrowOctagonListButton_Click"/>
                                    <TextBlock Grid.Column="1" Text="Bottle iCDP" Style="{StaticResource FieldLabelStyle}"
                                               Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="EscrowOctagonBottleCombo" Grid.Column="2"
                                              MinWidth="160" HorizontalAlignment="Stretch"
                                              DisplayMemberPath="Display"/>
                                </Grid>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button x:Name="EscrowOctagonUnlockButton" Content="Unlock Octagon bottle"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="180" Margin="0,0,8,8"
                                            Click="EscrowOctagonUnlockButton_Click"/>
                                    <Button x:Name="EscrowOctagonPeerButton" Content="OTBottle / Peer keys"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="160" Margin="0,0,8,8"
                                            Click="EscrowOctagonPeerButton_Click"
                                            ToolTip="fetchViableBottles + decrypt OTBottle (requires entropy already unlocked)"/>
                                    <Button x:Name="EscrowCkksVaultButton" Content="CKKS OpenVault"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="140" Margin="0,0,8,8"
                                            Click="EscrowCkksVaultButton_Click"
                                            ToolTip="Manatee + ProtectedCloudStorage (+ LimitedPeersAllowed): TLKShare→PCS service keys (82=Find My)"/>
                                    <TextBlock Text="(bottle unlock = 1 HSM attempt)"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="0,6,8,8" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="EscrowOctagonRkButton" Content="Unlock Octagon via RK"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="200" Margin="0,0,8,8"
                                            Click="EscrowOctagonRkButton_Click"
                                            ToolTip="Recovery Key → peer RK → fetchRecoverableTLKShares → Manatee/PCS/Passwords. No HSM attempt."/>
                                    <TextBlock Text="(PIN alternative: no EscrowProxy RECOVER)"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="0,6,8,8" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </WrapPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource LogSectionCardStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Log Escrow / Octagon"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="DecryptLogTextBox"
                                         Style="{StaticResource LogTextBoxStyle}"
                                         TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="0"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Backup -->
                <TabItem x:Name="BackupTab" Header="Device backups" IsEnabled="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.6*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="RefreshBackupsButton" Content="Refresh list"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,0,0,12"
                                Click="RefreshBackupsButton_Click"/>

                        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="8" Margin="0,0,0,8">
                            <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" CanUserAddRows="False"
                                      SelectionChanged="DevicesGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Device" Binding="{Binding ModelLabel}" Width="180"/>
                                    <DataGridTextColumn Header="Product code" Binding="{Binding ProductType}" Width="110"/>
                                    <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareModel, TargetNullValue=—}" Width="90"/>
                                    <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber, TargetNullValue=—}" Width="120"/>
                                    <DataGridTextColumn Header="UDID" Binding="{Binding HardwareUdid, TargetNullValue=—}" Width="200"/>
                                    <DataGridTextColumn Header="CloudKit ID" Binding="{Binding DeviceUuid}" Width="220"/>
                                    <DataGridTextColumn Header="Snapshot" Binding="{Binding SnapshotCount}" Width="72"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Grid.Row="2" Text="Snapshot backup" Style="{StaticResource SectionLabelStyle}"
                                   Margin="4,4,0,6"/>

                        <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="8" Margin="0,0,0,8">
                            <DataGrid x:Name="SnapshotsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" CanUserAddRows="False"
                                      SelectionChanged="SnapshotsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="UDID" Binding="{Binding ShortUuid}" Width="90"/>
                                    <DataGridTextColumn Header="Full UDID" Binding="{Binding BackupUuid, TargetNullValue=—}" Width="240"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="140"/>
                                    <DataGridTextColumn Header="iOS" Binding="{Binding IosLabel}" Width="120"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="90"/>
                                    <DataGridTextColumn Header="Fmt" Binding="{Binding BackupPropsVersionLabel}" Width="50"/>
                                    <DataGridTextColumn Header="SysDom" Binding="{Binding SystemDomainsLabel}" Width="60"/>
                                    <DataGridTextColumn Header="Passcode" Binding="{Binding PasscodeLabel}" Width="70"/>
                                    <DataGridTextColumn Header="Apple ID" Binding="{Binding AppleIdLabel}" Width="180"/>
                                    <DataGridTextColumn Header="Props" Binding="{Binding BackupPropsStatusLabel}" Width="110"/>
                                    <DataGridTextColumn Header="Record" Binding="{Binding RecordName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Grid Grid.Row="4" Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Output folder" Style="{StaticResource FieldLabelStyle}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="OutputFolderTextBox" Grid.Column="1" Margin="0,0,10,0"
                                     MinWidth="160" HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutput_Click"/>
                        </Grid>

                        <StackPanel Grid.Row="5" Margin="0,0,0,10">
                            <WrapPanel Margin="0,0,0,6">
                                <Button x:Name="DownloadButton" Content="Download backup (chain)"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="210" Margin="0,0,8,6" IsEnabled="False" Click="DownloadButton_Click"/>
                                <CheckBox x:Name="ChainSnapshotsCheckBox" Content="Chain from oldest"
                                          VerticalAlignment="Center" Margin="0,0,12,6"
                                          IsChecked="True"
                                          Checked="ChainSnapshotsCheckBox_Changed"
                                          Unchecked="ChainSnapshotsCheckBox_Changed"
                                          ToolTip="ON (default): download all device snapshots from oldest to newest so deltas reuse already decrypted files (CopySnapshot). OFF: selected snapshot only."/>
                                <TextBlock Text="Max assets (0=all)" Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,8,6" VerticalAlignment="Center"/>
                                <TextBox x:Name="MaxAssetsTextBox" Width="56" Text="0" Margin="0,0,12,6"/>
                                <CheckBox x:Name="ManifestOnlyCheckBox" Content="Manifest only"
                                          VerticalAlignment="Center" Margin="0,0,12,6"
                                          IsChecked="False"
                                          ToolTip="Catalog only S:→M:→files + local Manifest.db (no file download)"/>
                                <CheckBox x:Name="QuietLogCheckBox" Content="Errors only"
                                          VerticalAlignment="Center" Margin="0,0,12,6"
                                          IsChecked="True"
                                          Checked="QuietLogCheckBox_Changed"
                                          Unchecked="QuietLogCheckBox_Changed"
                                          ToolTip="Disable info/warning logs in UI and on disk (pending_chunks journal, NDJSON). Much faster. Env: IKE_QUIET=1"/>
                                <CheckBox x:Name="PersistRunLogsCheckBox" Content="Save run logs"
                                          VerticalAlignment="Center" Margin="0,0,12,6"
                                          IsChecked="False"
                                          Checked="PersistRunLogsCheckBox_Changed"
                                          Unchecked="PersistRunLogsCheckBox_Changed"
                                          ToolTip="When enabled, HTTP requests and responses including body and headers are logged; they need at least twice the free disk space compared to a single incremental/full snapshot size."/>
                                <CheckBox x:Name="FullHarCaptureCheckBox" Content="Full HAR (PoC)"
                                          VerticalAlignment="Center" Margin="0,0,12,6"
                                          IsChecked="False"
                                          Checked="FullHarCaptureCheckBox_Changed"
                                          Unchecked="FullHarCaptureCheckBox_Changed"
                                          ToolTip="Writes session.har + session_redacted.har with ALL req/resp (including HTTP OK). Also enables Save run logs. Env: IKE_FULL_HAR=1. Body &gt;8MB truncated with reference to http_bodies/."/>
                                <CheckBox x:Name="DumpAuthCheckBox" Content="Dump AUTH"
                                          VerticalAlignment="Center" Margin="0,0,12,6"
                                          IsChecked="False"
                                          ToolTip="Writes AUTH_BATCH_*.bin in the snapshot (debug only; not needed for decrypt). Env: IKE_DUMP_AUTH=1"/>
                                <CheckBox x:Name="DumpEdgeCheckBox" Content="Dump edge"
                                          VerticalAlignment="Center" Margin="0,0,12,6"
                                          IsChecked="False"
                                          ToolTip="Writes .edge_compact.bin / .ciphertext next to OBJ (offline only). OBJ staging is kept. Env: IKE_DUMP_EDGE=1"/>
                                <CheckBox x:Name="DumpKalamaCheckBox" Content="Dump Records KA, LA, MA"
                                          VerticalAlignment="Center" Margin="0,0,12,6"
                                          IsChecked="False"
                                          ToolTip="Writes kalama_records/query_*.bin (KA/LA/MA records; wrap already in RAM). Env: IKE_DUMP_KALAMA=1"/>
                                <ProgressBar x:Name="DownloadProgressBar" Width="160" Height="10" Margin="0,4,12,6"
                                             VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"
                                             ToolTip="Overall progress (completed files)"/>
                                <TextBlock x:Name="DownloadStatusText" Margin="0,0,8,6"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           TextWrapping="Wrap"/>
                            </WrapPanel>
                            <TextBlock x:Name="ForegroundMmcsText"
                                       Margin="0,2,0,6"
                                       Style="{StaticResource HintTextStyle}"
                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Text="FG MMCS: — (probe on restore startup)"
                                       ToolTip="Hardware-Id (f22) and x-apple-mmcs-plist-sha256 observed in early responses (zones / BackupAccount / D: / S: / mbs / Lock). Distinct from static values used in requests."/>
                            <WrapPanel>
                                <TextBlock Text="Downloaded" Style="{StaticResource FieldLabelStyle}"
                                           Width="72" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="DownloadFilesProgressBar" Width="140" Height="10"
                                             VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"
                                             ToolTip="Files downloaded out of total"/>
                                <TextBlock x:Name="DownloadFilesCountText" Margin="8,0,20,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="0 / 0"/>
                                <TextBlock Text="Decrypted" Style="{StaticResource FieldLabelStyle}"
                                           Width="72" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="DecryptFilesProgressBar" Width="140" Height="10"
                                             VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"
                                             ToolTip="Files decrypted out of total"/>
                                <TextBlock x:Name="DecryptFilesCountText" Margin="8,0,20,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="0 / 0"/>
                                <TextBlock x:Name="DecryptQueueText"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Decrypt queue: 0"
                                           ToolTip="Files queued or being decrypted"/>
                                <TextBlock x:Name="PendingChunksText" Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Pending: 0"
                                           ToolTip="Files waiting for MMCS chunks or Ford defer (H-ORDER) — not errors"/>
                                <TextBlock x:Name="DuplicatedFilesText" Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Duplicates: 0"
                                           ToolTip="Paths copied from an already downloaded shard (same signature)"/>
                                <TextBlock x:Name="CiphertextFilesText" Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Encrypted: 0"
                                           ToolTip="Files saved under Backup/ still ciphertext (no file-AES; incomplete parity or incomplete)"/>
                                <TextBlock x:Name="DecryptFailedText" Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Decrypt failed: 0"
                                           ToolTip="Files with final decrypt error (not PENDING)"/>
                                <TextBlock x:Name="DownloadElapsedText" Margin="20,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Time: 0:00"
                                           ToolTip="Elapsed time since backup download started"/>
                                <TextBlock x:Name="DownloadBytesText" Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Backup: — / —"
                                           ToolTip="Backup payload bytes downloaded/decrypted (file chunk data) / estimated remaining — does not include authorizeGet/query/FL"/>
                                <TextBlock x:Name="DownloadWireBytesText" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Network: —"
                                           ToolTip="Cumulative HTTP traffic (request + response body): CloudKit, authorizeGet, FL, edge MMCS, etc."/>
                                <ComboBox x:Name="DownloadBytesScaleCombo"
                                          Width="72" MinHeight="28" Margin="6,0,0,0"
                                          Padding="6,2"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          FontSize="12"
                                          SelectedIndex="0"
                                          ToolTip="Unit scale (Auto adapts at runtime; or B/KB/MB/GB/TB)"
                                          SelectionChanged="DownloadBytesScaleCombo_SelectionChanged">
                                    <ComboBoxItem Content="Auto" VerticalContentAlignment="Center"/>
                                    <ComboBoxItem Content="B" VerticalContentAlignment="Center"/>
                                    <ComboBoxItem Content="KB" VerticalContentAlignment="Center"/>
                                    <ComboBoxItem Content="MB" VerticalContentAlignment="Center"/>
                                    <ComboBoxItem Content="GB" VerticalContentAlignment="Center"/>
                                    <ComboBoxItem Content="TB" VerticalContentAlignment="Center"/>
                                </ComboBox>
                            </WrapPanel>
                        </StackPanel>

                        <Border Grid.Row="6" Style="{StaticResource LogSectionCardStyle}">
