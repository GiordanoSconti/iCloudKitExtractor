                                               Margin="0,0,0,4"/>
                                    <WebBrowser x:Name="ImapMessageBrowser"
                                                Navigating="ImapMessageBrowser_Navigating"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>


