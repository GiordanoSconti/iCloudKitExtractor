<Window x:Class="iCloudKitExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iCloudKit Extractor" Height="760" Width="1320"
        MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Background="{StaticResource MeshBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Soft Gemini-like color blobs -->
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="420" Height="420" Canvas.Left="-80" Canvas.Top="-120" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#994285F4" Offset="0"/>
                        <GradientStop Color="#004285F4" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="380" Height="380" Canvas.Left="780" Canvas.Top="20" Opacity="0.45">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#99A855F7" Offset="0"/>
                        <GradientStop Color="#00A855F7" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="460" Height="320" Canvas.Left="240" Canvas.Top="480" Opacity="0.40">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#88FB7185" Offset="0"/>
                        <GradientStop Color="#00FB7185" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="300" Height="300" Canvas.Left="620" Canvas.Top="380" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7734D399" Offset="0"/>
                        <GradientStop Color="#0034D399" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid Margin="22,22,22,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="22,18" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="10" Margin="0,0,16,0"
                            ClipToBounds="True"
                            Effect="{StaticResource SoftShadow}">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/app-icon.png"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="iCloud Backup Extractor" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0"
                                   Text="Login Apple ID · Escrow PCS · Backup download · WhatsApp CloudKit · iCloud Files · Sync Data"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource SessionChipStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SessionIndicator" Width="10" Height="10" Fill="{StaticResource IdleBrush}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SessionStatusText" VerticalAlignment="Center"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentABrush}"
                                       Text="Non autenticato"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="360" MinWidth="300" MaxWidth="480"/>
                </Grid.ColumnDefinitions>

            <TabControl x:Name="MainTabControl" Grid.Column="0">
                <!-- Accesso -->
                <TabItem x:Name="AccessTab" Header="Accesso">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Credenziali Apple ID" Style="{StaticResource SectionLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Apple ID" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="AppleIdTextBox" Grid.Column="1" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Row="1" Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Server Anisette" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock x:Name="AnisetteEnvOverrideText"
                                           Text="ANISETTE_SERVER_URL impostata: ha priorità sulla UI."
                                           Foreground="#B58600" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="AnisetteLocalRadio" Content="Locale (127.0.0.1:6971)"
                                                 IsChecked="True" GroupName="AnisetteServerMode"
                                                 Margin="0,0,16,0"
                                                 Checked="AnisetteServerModeRadio_Changed"/>
                                    <RadioButton x:Name="AnisetteRemoteRadio" Content="Server remoto"
                                                 GroupName="AnisetteServerMode"
                                                 Checked="AnisetteServerModeRadio_Changed"/>
                                </StackPanel>
                                <Grid x:Name="AnisetteRemoteFieldsPanel" IsEnabled="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="URL" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="AnisetteServerUrlTextBox" Grid.Column="1" Margin="0,0,0,8"
                                             ToolTip="Es. http://192.168.1.50:6969"/>
                                    <TextBlock Grid.Row="1" Text="Auth mode" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="AnisetteAuthModeCombo" Grid.Row="1" Grid.Column="1"
                                              Margin="0,0,0,8" Width="160" HorizontalAlignment="Left"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="iphone" Tag="iphone" IsSelected="True"/>
                                        <ComboBoxItem Content="hybrid" Tag="hybrid"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Text="License" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="AnisetteLicenseTextBox" Grid.Row="2" Grid.Column="1"
                                             ToolTip="Opzionale: Bearer token o path a file .license (server Licensed)"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="AnisetteTestButton" Content="Test connessione"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="132" Margin="0,0,8,0"
                                            Click="AnisetteTestButton_Click"/>
                                    <Button x:Name="AnisetteSaveButton" Content="Salva Anisette"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="132"
                                            Click="AnisetteSaveButton_Click"/>
                                    <TextBlock x:Name="AnisetteSettingsStatusText"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="LoginButton" Content="Accedi"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="132" Click="LoginButton_Click"/>
                        </StackPanel>

                        <Border x:Name="TwoFactorPanel" Grid.Row="3" Style="{StaticResource SectionCardStyle}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Verifica a due fattori" Style="{StaticResource SectionLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="TwoFactorDeviceRadio" Content="Dispositivo attendibile"
                                                 IsChecked="True" GroupName="TwoFactorMethod"
                                                 Checked="TwoFactorMethodRadio_Changed"/>
                                    <RadioButton x:Name="TwoFactorSmsRadio" Content="SMS"
                                                 GroupName="TwoFactorMethod"
                                                 Checked="TwoFactorMethodRadio_Changed"/>
                                </StackPanel>
                                <StackPanel x:Name="SmsPhonePanel" Orientation="Horizontal" Margin="0,0,0,10"
                                            Visibility="Collapsed">
                                    <ComboBox x:Name="SmsPhoneComboBox" Width="240" Margin="0,0,10,0"
                                              DisplayMemberPath="DisplayLabel"/>
                                    <Button x:Name="RequestSmsButton" Content="Invia SMS"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RequestSmsButton_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TwoFactorCodeTextBox" Width="140" Margin="0,0,10,0"/>
                                    <Button x:Name="Verify2FaButton" Content="Invia codice"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="Verify2FaButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource LogSectionCardStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Log autenticazione"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="AuthLogTextBox" Style="{StaticResource LogTextBoxStyle}"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Escrow -->
                <TabItem x:Name="EscrowTab" Header="Escrow KeyBagKey" IsEnabled="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,14"
                                           Text="PCS: Unlock EscrowedKeys (iCSC vuoto = DSID). Octagon: passcode bottle (HSM) oppure Recovery Key → TLK/Manatee/PCS (senza tentativo HSM)."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Cartella output" Style="{StaticResource FieldLabelStyle}" Width="120"/>
                                    <TextBox x:Name="DecryptOutputTextBox" Width="420" Margin="0,0,10,0"/>
                                    <Button Content="Sfoglia" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseDecryptOutput_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock x:Name="EscrowSecretLabel" Text="iCSC / passcode"
                                               Style="{StaticResource FieldLabelStyle}" Width="120"/>
                                    <PasswordBox x:Name="EscrowPasswordBox" Width="280" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="EscrowSecretHint" Text="(PCS SRP=DSID · Octagon bottle: passcode device)"
                                               Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Recovery Key"
                                               Style="{StaticResource FieldLabelStyle}" Width="120"/>
                                    <PasswordBox x:Name="EscrowRecoveryKeyBox" Width="280" Margin="0,0,12,0"
                                                 ToolTip="iCloud Recovery Key (XXXX-XXXX-…). Alternativa Octagon al PIN bottle."/>
                                    <TextBlock Text="altDSID"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="EscrowRecoverySaltBox" Width="200"
                                             ToolTip="Salt HKDF = altDSID/adsid (sempre da sessione dopo login)"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <CheckBox x:Name="EscrowSmsVariantCheckBox" Content="Variante SMS (securebackup)"
                                              VerticalAlignment="Center"
                                              Checked="EscrowSmsVariantCheckBox_Changed"
                                              Unchecked="EscrowSmsVariantCheckBox_Changed"/>
                                    <TextBlock x:Name="EscrowSmsCodeLabel" Text="Codice SMS"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="16,0,8,0" Visibility="Collapsed"/>
                                    <TextBox x:Name="EscrowSmsCodeBox" Width="120" Visibility="Collapsed"/>
                                    <CheckBox x:Name="EscrowRequestSmsCheckBox" Content="Invia SMS se manca codice"
                                              Margin="12,0,0,0" VerticalAlignment="Center"
                                              Visibility="Collapsed" IsChecked="True"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="EscrowPcsUnlockButton" Content="Unlock EscrowedKeys"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="180"
                                            Click="EscrowPcsUnlockButton_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="EscrowOctagonListButton" Content="Lista bottle iCDP"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="140" Margin="0,0,12,0"
                                            Click="EscrowOctagonListButton_Click"/>
                                    <TextBlock Text="Bottle iCDP" Style="{StaticResource FieldLabelStyle}"
                                               Width="120" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="EscrowOctagonBottleCombo" Width="400"
                                              DisplayMemberPath="Display"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="EscrowOctagonUnlockButton" Content="Unlock Octagon bottle"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="200"
                                            Click="EscrowOctagonUnlockButton_Click"/>
                                    <Button x:Name="EscrowOctagonPeerButton" Content="OTBottle / Peer keys"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="160" Margin="12,0,0,0"
                                            Click="EscrowOctagonPeerButton_Click"
                                            ToolTip="fetchViableBottles + decrypt OTBottle (serve entropy già sbloccata)"/>
                                    <Button x:Name="EscrowCkksVaultButton" Content="CKKS OpenVault"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="140" Margin="12,0,0,0"
                                            Click="EscrowCkksVaultButton_Click"
                                            ToolTip="Manatee + ProtectedCloudStorage (+ LimitedPeersAllowed): TLKShare→PCS service keys (82=Find My)"/>
                                    <TextBlock Text="(bottle unlock = 1 tentativo HSM)"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button x:Name="EscrowOctagonRkButton" Content="Unlock Octagon via RK"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="200"
                                            Click="EscrowOctagonRkButton_Click"
                                            ToolTip="Recovery Key → peer RK → fetchRecoverableTLKShares → Manatee/PCS/Passwords. Nessun tentativo HSM."/>
                                    <TextBlock Text="(alternativa al PIN: niente EscrowProxy RECOVER)"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource LogSectionCardStyle}">
                            <TextBox x:Name="DecryptLogTextBox" Style="{StaticResource LogTextBoxStyle}"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Backup -->
                <TabItem x:Name="BackupTab" Header="Backup dispositivi" IsEnabled="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.6*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="RefreshBackupsButton" Content="Aggiorna elenco"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,0,0,12"
                                Click="RefreshBackupsButton_Click"/>

                        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="8" Margin="0,0,0,8">
                            <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" CanUserAddRows="False"
                                      SelectionChanged="DevicesGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Dispositivo" Binding="{Binding ModelLabel}" Width="180"/>
                                    <DataGridTextColumn Header="Codice" Binding="{Binding ProductType}" Width="110"/>
                                    <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareModel, TargetNullValue=—}" Width="90"/>
                                    <DataGridTextColumn Header="Seriale" Binding="{Binding SerialNumber, TargetNullValue=—}" Width="120"/>
                                    <DataGridTextColumn Header="UDID" Binding="{Binding HardwareUdid, TargetNullValue=—}" Width="200"/>
                                    <DataGridTextColumn Header="CloudKit ID" Binding="{Binding DeviceUuid}" Width="220"/>
                                    <DataGridTextColumn Header="Snapshot" Binding="{Binding SnapshotCount}" Width="72"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Grid.Row="2" Text="Snapshot backup" Style="{StaticResource SectionLabelStyle}"
                                   Margin="4,4,0,6"/>

                        <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="8" Margin="0,0,0,8">
                            <DataGrid x:Name="SnapshotsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" CanUserAddRows="False"
                                      SelectionChanged="SnapshotsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="UDID" Binding="{Binding ShortUuid}" Width="90"/>
                                    <DataGridTextColumn Header="UDID completo" Binding="{Binding BackupUuid, TargetNullValue=—}" Width="240"/>
                                    <DataGridTextColumn Header="Data" Binding="{Binding DateLabel}" Width="140"/>
                                    <DataGridTextColumn Header="iOS" Binding="{Binding IosLabel}" Width="120"/>
                                    <DataGridTextColumn Header="Dimensione" Binding="{Binding SizeLabel}" Width="90"/>
                                    <DataGridTextColumn Header="Fmt" Binding="{Binding BackupPropsVersionLabel}" Width="50"/>
                                    <DataGridTextColumn Header="SysDom" Binding="{Binding SystemDomainsLabel}" Width="60"/>
                                    <DataGridTextColumn Header="Passcode" Binding="{Binding PasscodeLabel}" Width="70"/>
                                    <DataGridTextColumn Header="Apple ID" Binding="{Binding AppleIdLabel}" Width="180"/>
                                    <DataGridTextColumn Header="Props" Binding="{Binding BackupPropsStatusLabel}" Width="110"/>
                                    <DataGridTextColumn Header="Record" Binding="{Binding RecordName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,10">
                            <TextBlock Text="Cartella output" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="OutputFolderTextBox" Width="500" Margin="10,0,10,0"/>
                            <Button Content="Sfoglia" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutput_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="DownloadButton" Content="Scarica backup (catena)"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="210" IsEnabled="False" Click="DownloadButton_Click"/>
                                <CheckBox x:Name="ChainSnapshotsCheckBox" Content="Catena da più vecchio"
                                          VerticalAlignment="Center" Margin="12,0,0,0"
                                          IsChecked="True"
                                          Checked="ChainSnapshotsCheckBox_Changed"
                                          Unchecked="ChainSnapshotsCheckBox_Changed"
                                          ToolTip="ON (default): scarica tutti gli snapshot del device dal più vecchio al più recente, così i delta riusano i file già decifrati (CopySnapshot). OFF: solo lo snapshot selezionato."/>
                                <TextBlock Text="Max asset (0=tutti)" Style="{StaticResource FieldLabelStyle}"
                                           Margin="16,0,8,0"/>
                                <TextBox x:Name="MaxAssetsTextBox" Width="56" Text="0"/>
                                <CheckBox x:Name="ManifestOnlyCheckBox" Content="Solo Manifest"
                                          VerticalAlignment="Center" Margin="16,0,0,0"
                                          IsChecked="False"
                                          ToolTip="Solo catalogo S:→M:→files + Manifest.db locale (niente download file)"/>
                                <CheckBox x:Name="QuietLogCheckBox" Content="Solo errori"
                                          VerticalAlignment="Center" Margin="16,0,0,0"
                                          IsChecked="True"
                                          Checked="QuietLogCheckBox_Changed"
                                          Unchecked="QuietLogCheckBox_Changed"
                                          ToolTip="Disattiva log info/warning in UI e su disco (pending_chunks journal, NDJSON). Molto più veloce. Env: IKE_QUIET=1"/>
                                <CheckBox x:Name="PersistRunLogsCheckBox" Content="Salva log run"
                                          VerticalAlignment="Center" Margin="12,0,0,0"
                                          IsChecked="False"
                                          Checked="PersistRunLogsCheckBox_Changed"
                                          Unchecked="PersistRunLogsCheckBox_Changed"
                                          ToolTip="Attivando i log verranno registrate le richieste e risposte HTTP comprensive di body e headers, le quali avranno bisogno almeno di due volte lo spazio libero sul disco rispetto alle dimensioni del singolo snapshot incrementale/completo)."/>
                                <CheckBox x:Name="FullHarCaptureCheckBox" Content="HAR completo (PoC)"
                                          VerticalAlignment="Center" Margin="12,0,0,0"
                                          IsChecked="False"
                                          Checked="FullHarCaptureCheckBox_Changed"
                                          Unchecked="FullHarCaptureCheckBox_Changed"
                                          ToolTip="Scrive session.har + session_redacted.har con TUTTE le req/resp (anche HTTP OK). Attiva anche «Salva log run». Env: IKE_FULL_HAR=1. Body &gt;8MB truncati con riferimento a http_bodies/."/>
                                <CheckBox x:Name="DumpAuthCheckBox" Content="Dump AUTH"
                                          VerticalAlignment="Center" Margin="12,0,0,0"
                                          IsChecked="False"
                                          ToolTip="Scrive AUTH_BATCH_*.bin nello snapshot (solo debug; non serve al decrypt). Env: IKE_DUMP_AUTH=1"/>
                                <CheckBox x:Name="DumpEdgeCheckBox" Content="Dump edge"
                                          VerticalAlignment="Center" Margin="8,0,0,0"
                                          IsChecked="False"
                                          ToolTip="Scrive .edge_compact.bin / .ciphertext accanto a OBJ (solo offline). Lo staging OBJ resta. Env: IKE_DUMP_EDGE=1"/>
                                <CheckBox x:Name="DumpKalamaCheckBox" Content="Dump Records KA, LA, MA"
                                          VerticalAlignment="Center" Margin="8,0,0,0"
                                          IsChecked="False"
                                          ToolTip="Scrive kalama_records/query_*.bin (record KA/LA/MA; wrap già in RAM). Env: IKE_DUMP_KALAMA=1"/>
                                <ProgressBar x:Name="DownloadProgressBar" Width="180" Height="10" Margin="16,0,0,0"
                                             VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"
                                             ToolTip="Avanzamento complessivo (file completati)"/>
                                <TextBlock x:Name="DownloadStatusText" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Scaricati" Style="{StaticResource FieldLabelStyle}"
                                           Width="72" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="DownloadFilesProgressBar" Width="140" Height="10"
                                             VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"
                                             ToolTip="File scaricati sul totale"/>
                                <TextBlock x:Name="DownloadFilesCountText" Margin="8,0,20,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="0 / 0"/>
                                <TextBlock Text="Decifrati" Style="{StaticResource FieldLabelStyle}"
                                           Width="72" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="DecryptFilesProgressBar" Width="140" Height="10"
                                             VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"
                                             ToolTip="File decifrati sul totale"/>
                                <TextBlock x:Name="DecryptFilesCountText" Margin="8,0,20,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="0 / 0"/>
                                <TextBlock x:Name="DecryptQueueText"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Coda decrypt: 0"
                                           ToolTip="File in coda o in corso di decifrazione"/>
                                <TextBlock x:Name="PendingChunksText" Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Pending: 0"
                                           ToolTip="File in attesa chunk MMCS o defer Ford (H-ORDER) — non sono errori"/>
                                <TextBlock x:Name="DuplicatedFilesText" Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Duplicati: 0"
                                           ToolTip="Path copiati da shard già scaricato (stessa signature)"/>
                                <TextBlock x:Name="CiphertextFilesText" Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="Cifrati: 0"
                                           ToolTip="File salvati in Backup/ ancora ciphertext (no file-AES; parity incompleta o incompleti)"/>
