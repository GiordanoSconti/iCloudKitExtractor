                                           Style="{StaticResource HintTextStyle}"
                                           Text="Waiting — sign in first."/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="ContactsExplorerColumn" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LogSectionCardStyle}">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Text="Service response"
                                                   Style="{StaticResource SectionLabelStyle}"
                                                   Margin="0,0,0,4"/>
                                        <TextBox x:Name="ExploratoryServicesResultTextBox"
                                                 Style="{StaticResource LogTextBoxStyle}"
                                                 IsReadOnly="True"
                                                 Text="Query responses will appear here."/>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="ContactsExplorerPanel"
                                        Grid.Column="1"
                                        Style="{StaticResource LogSectionCardStyle}"
                                        Margin="10,0,0,0"
                                        Visibility="Collapsed"
                                        MinWidth="280">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Text="Contacts — detail"
                                                   Style="{StaticResource SectionLabelStyle}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Style="{StaticResource HintTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"
                                                   Text="Select a contact, then load vCard or photo (read-only)."/>
                                        <ListBox x:Name="ContactsListBox"
                                                 DockPanel.Dock="Top"
                                                 Height="140"
                                                 Margin="0,0,0,8"
                                                 SelectionChanged="ContactsListBox_SelectionChanged"/>
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button x:Name="ContactsLoadVcardButton"
                                                    Content="Load vCard"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    MinWidth="110" Margin="0,0,8,0"
                                                    IsEnabled="False"
                                                    Click="ContactsLoadVcardButton_Click"
                                                    ToolTip="GET the selected contact’s .vcf resource"/>
                                            <Button x:Name="ContactsLoadPhotoButton"
                                                    Content="Show photo"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    MinWidth="110"
                                                    IsEnabled="False"
                                                    Click="ContactsLoadPhotoButton_Click"
                                                    ToolTip="GET PHOTO URL (gateway.icloud.com/contacts/…)"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Top"
                                                Height="160"
                                                Margin="0,0,0,8"
                                                Background="#11000000"
                                                CornerRadius="4">
                                            <Image x:Name="ContactsPhotoImage"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <TextBox x:Name="ContactsVcardTextBox"
                                                 Style="{StaticResource LogTextBoxStyle}"
                                                 IsReadOnly="True"
                                                 Text="vCard of selected contact…"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <!-- Tabella dispositivi Find My Items (dopo decrypt BeaconStore) -->
                            <Border x:Name="FindMyDevicesPanel"
                                    Grid.Row="1"
                                    Style="{StaticResource SectionCardStyle}"
                                    Padding="8"
                                    Margin="0,10,0,0"
                                    Visibility="Collapsed"
                                    MinHeight="160"
                                    MaxHeight="280">
                                <DockPanel LastChildFill="True">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock Text="Find My Items — decrypted devices"
                                                   Style="{StaticResource SectionLabelStyle}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FindMyDevicesCountText"
                                                   Style="{StaticResource HintTextStyle}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text=""/>
                                    </DockPanel>
                                    <DataGrid x:Name="FindMyDevicesGrid"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110"/>
                                            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
                                            <DataGridTextColumn Header="Serial / ID" Binding="{Binding Serial}" Width="200"/>
                                            <DataGridTextColumn Header="Paired (UTC)" Binding="{Binding PairingDate}" Width="160"/>
                                            <DataGridTextColumn Header="FW" Binding="{Binding SystemVersion}" Width="80"/>
                                            <DataGridTextColumn Header="Bat" Binding="{Binding BatteryLevel}" Width="50"/>
                                            <DataGridTextColumn Header="Keys" Binding="{Binding KeysLabel}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Dispositivi fidati (post-login GrandSlam) — accanto a Servizi iCloud -->
                <TabItem x:Name="TrustedDevicesTab" Header="Trusted devices (Work in progress)" IsEnabled="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,8"
                                           Text="Trust Apple ID / session token (after SRP GrandSlam login)."/>
                                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,14"
                                           TextWrapping="Wrap"
                                           Text="Apple ID 2FA list (HSA2) ≠ IDS ≠ web TrustToken. If GSA does not prompt for 2FA, current ADI is already trusted: use New ADI identity then Register on 2FA list (e-mail/password below, not Sign in)."/>
                                <TextBlock Text="HSA2 credentials (2FA list only)" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Apple ID" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <TextBox x:Name="Hsa2AppleIdTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                             ToolTip="Apple ID e-mail for Register on 2FA list — independent from Sign in tab"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <PasswordBox x:Name="Hsa2PasswordBox" Grid.Row="1" Grid.Column="1"
                                                 ToolTip="Apple ID password (not PET). Required for HSA2 challenge."/>
                                </Grid>
                                <WrapPanel>
                                    <Button x:Name="TrustedDevicesRefreshButton"
                                            Content="Refresh status"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="140" Margin="0,0,10,8"
                                            Click="TrustedDevicesRefreshButton_Click"/>
                                    <Button x:Name="ApsActivateButton"
                                            Content="Attiva Albert"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="130" Margin="0,0,10,8"
                                            Click="ApsActivateButton_Click"
                                            ToolTip="Albert Windows → DeviceCertificate APS"/>
                                    <Button x:Name="ApsConnectButton"
                                            Content="Connect APS"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="130" Margin="0,0,10,8"
                                            Click="ApsConnectButton_Click"
                                            ToolTip="Courier APS: connect + push token"/>
                                    <Button x:Name="IdsEnrollButton"
                                            Content="Enroll IDS"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="140" Margin="0,0,10,8"
                                            Click="IdsEnrollButton_Click"
                                            ToolTip="Delegate PET → authenticateDS → id-register (multiplex1/FMF). Requires APS token."/>
                                    <Button x:Name="Hsa2NewAdiButton"
                                            Content="New ADI identity"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="160" Margin="0,0,10,8"
                                            Click="Hsa2NewAdiButton_Click"
                                            ToolTip="Clears local UUID/ADI + MidService (POST /provision?newIdentity=1). Use if Apple no longer prompts for 2FA on this machine."/>
                                    <Button x:Name="Hsa2RegisterButton"
                                            Content="Register on 2FA list"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="180" Margin="0,0,10,8"
                                            Click="Hsa2RegisterButton_Click"
                                            ToolTip="Native GSA: HSA2 e-mail/password from this tab + ptkn → 2FA challenge → OTP"/>
                                    <Button x:Name="ApsDisconnectButton"
                                            Content="Disconnect APS"
                                            Style="{StaticResource GhostButtonStyle}"
                                            MinWidth="130" Margin="0,0,10,8"
                                            Click="ApsDisconnectButton_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="ApsTokenText"
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="0,4,0,8"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           Text="APS push token: (not connected)"/>
                                <Border x:Name="IdmsaOtpPanel" Margin="0,8,0,0" Visibility="Collapsed"
                                        BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock x:Name="IdmsaOtpTitleText"
                                                   Text="HSA2 OTP — code from already trusted Apple device"
                                                   Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <RadioButton x:Name="IdmsaOtpDeviceRadio" Content="Trusted device"
                                                         IsChecked="True" GroupName="IdmsaOtpMethod"
                                                         Checked="IdmsaOtpMethodRadio_Changed"/>
                                            <RadioButton x:Name="IdmsaOtpSmsRadio" Content="SMS"
                                                         GroupName="IdmsaOtpMethod" Margin="16,0,0,0"
                                                         Checked="IdmsaOtpMethodRadio_Changed"/>
                                        </StackPanel>
                                        <StackPanel x:Name="IdmsaOtpSmsPhonePanel" Orientation="Horizontal"
                                                    Margin="0,0,0,8" Visibility="Collapsed">
                                            <ComboBox x:Name="IdmsaOtpPhoneComboBox" Width="240" Margin="0,0,10,0"
                                                      DisplayMemberPath="DisplayLabel"/>
                                            <Button x:Name="IdmsaOtpRequestSmsButton" Content="Send SMS"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="IdmsaOtpRequestSmsButton_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="IdmsaOtpCodeTextBox" Width="140" Margin="0,0,10,0"
                                                     ToolTip="6-digit code from already trusted Apple device"/>
                                            <Button x:Name="IdmsaOtpSubmitButton" Content="Submit OTP"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="IdmsaOtpSubmitButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="TrustedDevicesStatusText"
                                           Style="{StaticResource HintTextStyle}" Margin="0,10,0,0"
                                           Text="Waiting — sign in first."/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource LogSectionCardStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Trust status"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="TrustedDevicesResultTextBox"
                                         Style="{StaticResource LogTextBoxStyle}"
                                         IsReadOnly="True"
                                         Text="After sign-in, ADSID/PET/trust status will appear."/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Sync Data -->
                <TabItem x:Name="SyncDataTab" Header="iCloud Sync Data (Work in progress)" IsEnabled="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,14"
                                           Text="After login: Photos (ON by default), Account Info, Voice Memos, Calls and Messages are recoverable; other Sync Data categories show as (coming soon). Messages: CloudKit sync + MMCS download attempt on content.icloud.com when ckAssets exist. Calls: Phone &amp; FaceTime in iCloud + Escrow/Octagon."/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*" MinWidth="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Output folder" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SyncDataOutputTextBox" Grid.Column="1" Margin="0,0,10,0"
                                             MinWidth="140" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseSyncDataOutput_Click"/>
                                </Grid>
                                <TextBlock x:Name="SyncDataServicesHintText" Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,8"
                                           Text="Sync Data services — sign in to load available dataclasses."/>
                                <WrapPanel x:Name="SyncDataServicesPanel" Margin="0,0,0,8"/>
                                <StackPanel x:Name="SyncDataPhotosOptionsPanel"
                                            Margin="0,0,0,14"
                                            Visibility="Collapsed">
                                    <CheckBox x:Name="SyncDataBuildRecordMetadataCheckBox"
                                              Content="Photos: BuildRecordMetadata (original PCS filenames — slow)"
                                              IsChecked="False"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              ToolTip="After Album/Photos.db, decrypt filenameEnc/originalFilenameEnc from CPL pages and save to decrypt_cache. Optional and slow on large libraries; not needed for Album or MMCS."/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SyncDataProbeButton" Content="Retrieve Sync Data"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Left" MinWidth="200"
                                                Click="SyncDataProbeButton_Click"/>
                                        <ProgressBar x:Name="SyncDataProgressBar" Width="220" Height="10"
                                                     Margin="16,0,0,0" VerticalAlignment="Center"
                                                     Maximum="100" Value="0"
                                                     ToolTip="Overall Sync Data progress"/>
                                        <TextBlock x:Name="SyncDataStatusText" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource HintTextStyle}"
                                                   Text="Waiting"/>
                                    </StackPanel>
                                    <StackPanel x:Name="SyncDataPhasePanel" Orientation="Horizontal"
                                                Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="SyncDataPhaseLabel" Width="100"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Text="Phase"/>
                                        <ProgressBar x:Name="SyncDataPhaseProgressBar" Width="220" Height="10"
                                                     VerticalAlignment="Center"
                                                     Maximum="100" Value="0"
                                                     ToolTip="Download / decrypt in progress"/>
                                        <TextBlock x:Name="SyncDataPhaseStatusText" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource HintTextStyle}"
                                                   Text=""/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource LogSectionCardStyle}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Top" Content="Copy log"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Right" Margin="0,0,0,2"
                                        Click="CopySyncDataLog_Click"
                                        ToolTip="Copy active tab log text to clipboard"/>
                                <TabControl x:Name="SyncDataLogTabs"
                                            Style="{StaticResource LogTabControlStyle}"
                                            ItemContainerStyle="{StaticResource LogTabItemStyle}">
                                    <TabItem Header="Information / Warnings">
                                        <RichTextBox x:Name="SyncDataInfoLogBox"
                                                     Style="{StaticResource LogRichTextBoxStyle}">
                                            <FlowDocument PagePadding="12,10,12,10" LineHeight="18"/>
                                        </RichTextBox>
                                    </TabItem>
                                    <TabItem Header="Errors">
                                        <RichTextBox x:Name="SyncDataErrorLogBox"
                                                     Style="{StaticResource LogRichTextBoxStyle}">
                                            <FlowDocument PagePadding="12,10,12,10" LineHeight="18"/>
                                        </RichTextBox>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

                <!-- Token / servizi / Quota: fuori dalle schede, sempre visibili -->
                <Border x:Name="SideSessionPanel"
                        Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource SectionCardStyle}" Padding="12,12"
                        MinHeight="160">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="72"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*" MinHeight="72"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*" MinHeight="72"/>
                        </Grid.RowDefinitions>

                        <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right"
                                        Content="Copy"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,3"
                                        MinWidth="64"
                                        Click="CopySessionTokensButton_Click"
                                        ToolTip="Copy full session tokens to clipboard"/>
                                <TextBlock Text="Session tokens"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            </DockPanel>
                            <TextBox x:Name="SessionTokensTextBox"
                                     Style="{StaticResource LogTextBoxStyle}"
                                     MinHeight="80"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="Sign in to view recovered tokens."
                                     ToolTip="Full session tokens (post-login / SPD)."/>
                        </DockPanel>

                        <DockPanel Grid.Row="2" LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right"
                                        Content="Copy"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,3"
                                        MinWidth="64"
                                        Click="CopySessionServicesButton_Click"
                                        ToolTip="Copy services / dataclass / URLs to clipboard"/>
                                <TextBlock Text="Services / dataclass"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            </DockPanel>
                            <TextBox x:Name="SessionServicesTextBox"
                                     Style="{StaticResource LogTextBoxStyle}"
                                     MinHeight="80"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="Sign in to view available services."
                                     ToolTip="Full GsServiceTokens (spd.t), dataclass endpoint URLs and list from get_account_settings."/>
                        </DockPanel>

                        <DockPanel Grid.Row="4" LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Refresh"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,3"
                                            MinWidth="72"
                                            Margin="0,0,6,0"
                                            Click="RefreshCloudQuotaButton_Click"
                                            ToolTip="Reload getQuotaInfo / storageUsage* (read-only)"/>
                                    <Button Content="Copy"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,3"
                                            MinWidth="64"
                                            Click="CopyCloudQuotaButton_Click"
                                            ToolTip="Copy Cloud storage details to clipboard"/>
                                </StackPanel>
                                <TextBlock Text="iCloud storage details"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            </DockPanel>
                            <TextBox x:Name="CloudQuotaTextBox"
                                     Style="{StaticResource LogTextBoxStyle}"
                                     MinHeight="80"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="Sign in to load iCloud storage."
                                     ToolTip="iCloud quota (getQuotaInfo, storageUsageInfo, storageUsageDetails) — read-only."/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Background="#CCFFFFFF"
                BorderBrush="#1A1B1C1F"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <TextBlock Text="Copyright Giordano Sconti Forensis-Lab Development &amp; Research Sector 2026"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="11.5"
                       Foreground="{StaticResource MutedInkBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- First-connection license overlay (Package C) -->
        <Grid x:Name="LicenseIssuedOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Panel.ZIndex="100">
            <Border Background="#990A3038"/>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="560"
                    Margin="24"
                    Padding="28,24"
                    CornerRadius="16"
                    Background="#F2F8FB"
                    BorderBrush="#330A7A8F"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#0A3038"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Anisette license issued"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#0E2430"
                               Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="#3D5561"
                               Margin="0,0,0,14"
                               Text="Save this value in the License field. It will not be sent again on future connections from this machine."/>
                    <TextBox x:Name="LicenseIssuedValueBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="11"
                             Padding="10"
                             Margin="0,0,0,14"
                             Background="#E8F1F4"
                             BorderBrush="#220A7A8F"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Copy"
                                Padding="18,8"
                                Margin="0,0,10,0"
                                Click="LicenseOverlayCopy_Click"/>
                        <Button Content="I saved it"
                                Padding="18,8"
                                Click="LicenseOverlayDismiss_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
