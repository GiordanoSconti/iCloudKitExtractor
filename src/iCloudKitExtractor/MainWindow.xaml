                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="110"/>
                                            <DataGridTextColumn Header="Modello" Binding="{Binding Model}" Width="100"/>
                                            <DataGridTextColumn Header="Seriale / ID" Binding="{Binding Serial}" Width="200"/>
                                            <DataGridTextColumn Header="Paired (UTC)" Binding="{Binding PairingDate}" Width="160"/>
                                            <DataGridTextColumn Header="FW" Binding="{Binding SystemVersion}" Width="80"/>
                                            <DataGridTextColumn Header="Bat" Binding="{Binding BatteryLevel}" Width="50"/>
                                            <DataGridTextColumn Header="Chiavi" Binding="{Binding KeysLabel}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Dispositivi fidati (post-login GrandSlam) — accanto a Servizi iCloud -->
                <TabItem x:Name="TrustedDevicesTab" Header="Dispositivi fidati (Work in progress)" IsEnabled="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,8"
                                           Text="Trust Apple ID / token sessione (dopo login SRP GrandSlam)."/>
                                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,14"
                                           TextWrapping="Wrap"
                                           Text="Lista 2FA Apple ID (HSA2) ≠ IDS ≠ TrustToken web. Se GSA non chiede 2FA, l’ADI attuale è già trusted: usa «Nuova identità ADI» poi «Registra in lista 2FA» (e-mail/password sotto, non Accesso)."/>
                                <TextBlock Text="Credenziali HSA2 (solo lista 2FA)" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Apple ID" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <TextBox x:Name="Hsa2AppleIdTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                             ToolTip="E-mail Apple ID per Registra in lista 2FA — indipendente dalla scheda Accesso"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <PasswordBox x:Name="Hsa2PasswordBox" Grid.Row="1" Grid.Column="1"
                                                 ToolTip="Password Apple ID (non PET). Obbligatoria per il challenge HSA2."/>
                                </Grid>
                                <WrapPanel>
                                    <Button x:Name="TrustedDevicesRefreshButton"
                                            Content="Aggiorna stato"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="140" Margin="0,0,10,8"
                                            Click="TrustedDevicesRefreshButton_Click"/>
                                    <Button x:Name="ApsActivateButton"
                                            Content="Attiva Albert"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="130" Margin="0,0,10,8"
                                            Click="ApsActivateButton_Click"
                                            ToolTip="Albert Windows → DeviceCertificate APS"/>
                                    <Button x:Name="ApsConnectButton"
                                            Content="Connetti APS"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="130" Margin="0,0,10,8"
                                            Click="ApsConnectButton_Click"
                                            ToolTip="Courier APS: connect + push token"/>
                                    <Button x:Name="IdsEnrollButton"
                                            Content="Enroll IDS"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="140" Margin="0,0,10,8"
                                            Click="IdsEnrollButton_Click"
                                            ToolTip="Delegate PET → authenticateDS → id-register (multiplex1/FMF). Richiede APS token."/>
                                    <Button x:Name="Hsa2NewAdiButton"
                                            Content="Nuova identità ADI"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="160" Margin="0,0,10,8"
                                            Click="Hsa2NewAdiButton_Click"
                                            ToolTip="Cancella UUID/ADI locali + MidService (POST /provision?newIdentity=1). Serve se Apple non chiede più 2FA su questa macchina."/>
                                    <Button x:Name="Hsa2RegisterButton"
                                            Content="Registra in lista 2FA"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="180" Margin="0,0,10,8"
                                            Click="Hsa2RegisterButton_Click"
                                            ToolTip="GSA nativo: e-mail/password HSA2 di questa scheda + ptkn → challenge 2FA → OTP"/>
                                    <Button x:Name="ApsDisconnectButton"
                                            Content="Disconnetti APS"
                                            Style="{StaticResource GhostButtonStyle}"
                                            MinWidth="130" Margin="0,0,10,8"
                                            Click="ApsDisconnectButton_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="ApsTokenText"
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="0,4,0,8"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           Text="Push token APS: (non connesso)"/>
                                <Border x:Name="IdmsaOtpPanel" Margin="0,8,0,0" Visibility="Collapsed"
                                        BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock x:Name="IdmsaOtpTitleText"
                                                   Text="OTP HSA2 — codice dal dispositivo Apple già fidato"
                                                   Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <RadioButton x:Name="IdmsaOtpDeviceRadio" Content="Dispositivo attendibile"
                                                         IsChecked="True" GroupName="IdmsaOtpMethod"
                                                         Checked="IdmsaOtpMethodRadio_Changed"/>
                                            <RadioButton x:Name="IdmsaOtpSmsRadio" Content="SMS"
                                                         GroupName="IdmsaOtpMethod" Margin="16,0,0,0"
                                                         Checked="IdmsaOtpMethodRadio_Changed"/>
                                        </StackPanel>
                                        <StackPanel x:Name="IdmsaOtpSmsPhonePanel" Orientation="Horizontal"
                                                    Margin="0,0,0,8" Visibility="Collapsed">
                                            <ComboBox x:Name="IdmsaOtpPhoneComboBox" Width="240" Margin="0,0,10,0"
                                                      DisplayMemberPath="DisplayLabel"/>
                                            <Button x:Name="IdmsaOtpRequestSmsButton" Content="Invia SMS"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="IdmsaOtpRequestSmsButton_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="IdmsaOtpCodeTextBox" Width="140" Margin="0,0,10,0"
                                                     ToolTip="Codice a 6 cifre dal dispositivo Apple già fidato"/>
                                            <Button x:Name="IdmsaOtpSubmitButton" Content="Invia OTP"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="IdmsaOtpSubmitButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="TrustedDevicesStatusText"
                                           Style="{StaticResource HintTextStyle}" Margin="0,10,0,0"
                                           Text="In attesa — effettua il login."/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource LogSectionCardStyle}">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Stato trust"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="TrustedDevicesResultTextBox"
                                         Style="{StaticResource LogTextBoxStyle}"
                                         IsReadOnly="True"
                                         Text="Dopo il login apparirà lo stato ADSID/PET/trust."/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Sync Data -->
                <TabItem x:Name="SyncDataTab" Header="iCloud Sync Data (Work in progress)" IsEnabled="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,14"
                                           Text="Dopo login: Photos (ON di default) e Account Info sono recuperabili; le altre categorie Sync Data compaiono come (presto) e restano disabilitate."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="Cartella output" Style="{StaticResource FieldLabelStyle}" Width="120"/>
                                    <TextBox x:Name="SyncDataOutputTextBox" Width="420" Margin="0,0,10,0"/>
                                    <Button Content="Sfoglia" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseSyncDataOutput_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="SyncDataServicesHintText" Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,8"
                                           Text="Servizi Sync Data — effettua il login per caricare le dataclass disponibili."/>
                                <WrapPanel x:Name="SyncDataServicesPanel" Margin="0,0,0,8"/>
                                <StackPanel x:Name="SyncDataPhotosOptionsPanel"
                                            Margin="0,0,0,14"
                                            Visibility="Collapsed">
                                    <CheckBox x:Name="SyncDataBuildRecordMetadataCheckBox"
                                              Content="Photos: BuildRecordMetadata (nomi file originali PCS — lento)"
                                              IsChecked="False"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              ToolTip="Dopo Album/Photos.db, decifra filenameEnc/originalFilenameEnc dalle pagine CPL e li salva in decrypt_cache. Opzionale e lento su librerie grandi; non serve per Album o MMCS."/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SyncDataProbeButton" Content="Recupera Sync Data"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Left" MinWidth="200"
                                                Click="SyncDataProbeButton_Click"/>
                                        <ProgressBar x:Name="SyncDataProgressBar" Width="220" Height="10"
                                                     Margin="16,0,0,0" VerticalAlignment="Center"
                                                     Maximum="100" Value="0"
                                                     ToolTip="Avanzamento complessivo Sync Data"/>
                                        <TextBlock x:Name="SyncDataStatusText" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource HintTextStyle}"
                                                   Text="In attesa"/>
                                    </StackPanel>
                                    <StackPanel x:Name="SyncDataPhasePanel" Orientation="Horizontal"
                                                Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="SyncDataPhaseLabel" Width="100"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Text="Fase"/>
                                        <ProgressBar x:Name="SyncDataPhaseProgressBar" Width="220" Height="10"
                                                     VerticalAlignment="Center"
                                                     Maximum="100" Value="0"
                                                     ToolTip="Stato download / decifratura in corso"/>
                                        <TextBlock x:Name="SyncDataPhaseStatusText" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource HintTextStyle}"
                                                   Text=""/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource LogSectionCardStyle}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Top" Content="Copia log"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Right" Margin="0,0,0,2"
                                        Click="CopySyncDataLog_Click"
                                        ToolTip="Copia il testo del log della scheda attiva negli appunti"/>
                                <TabControl x:Name="SyncDataLogTabs"
                                            Style="{StaticResource LogTabControlStyle}"
                                            ItemContainerStyle="{StaticResource LogTabItemStyle}">
                                    <TabItem Header="Informazioni / Avvisi">
                                        <RichTextBox x:Name="SyncDataInfoLogBox"
                                                     Style="{StaticResource LogRichTextBoxStyle}">
                                            <FlowDocument PagePadding="12,10,12,10" LineHeight="18"/>
                                        </RichTextBox>
                                    </TabItem>
                                    <TabItem Header="Errori">
                                        <RichTextBox x:Name="SyncDataErrorLogBox"
                                                     Style="{StaticResource LogRichTextBoxStyle}">
                                            <FlowDocument PagePadding="12,10,12,10" LineHeight="18"/>
                                        </RichTextBox>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

                <!-- Token / servizi / Quota: fuori dalle schede, sempre visibili -->
                <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right"
                                        Content="Copia"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,3"
                                        MinWidth="64"
                                        Click="CopySessionTokensButton_Click"
                                        ToolTip="Copia i token di sessione completi negli appunti"/>
                                <TextBlock Text="Token sessione"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            </DockPanel>
                            <TextBox x:Name="SessionTokensTextBox"
                                     Style="{StaticResource LogTextBoxStyle}"
                                     MinHeight="80"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="Effettua il login per vedere i token recuperati."
                                     ToolTip="Token di sessione completi (post-login / SPD)."/>
                        </DockPanel>

                        <DockPanel Grid.Row="2" LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right"
                                        Content="Copia"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,3"
                                        MinWidth="64"
                                        Click="CopySessionServicesButton_Click"
                                        ToolTip="Copia servizi / dataclass / URL negli appunti"/>
                                <TextBlock Text="Servizi / dataclass"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            </DockPanel>
                            <TextBox x:Name="SessionServicesTextBox"
                                     Style="{StaticResource LogTextBoxStyle}"
                                     MinHeight="80"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="Effettua il login per vedere i servizi disponibili."
                                     ToolTip="GsServiceTokens (spd.t) completi, URL endpoint per dataclass e elenco da get_account_settings."/>
                        </DockPanel>

                        <DockPanel Grid.Row="4" LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Aggiorna"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,3"
                                            MinWidth="72"
                                            Margin="0,0,6,0"
                                            Click="RefreshCloudQuotaButton_Click"
                                            ToolTip="Ricarica getQuotaInfo / storageUsage* (solo lettura)"/>
                                    <Button Content="Copia"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,3"
                                            MinWidth="64"
                                            Click="CopyCloudQuotaButton_Click"
                                            ToolTip="Copia i dettagli spazio Cloud negli appunti"/>
                                </StackPanel>
                                <TextBlock Text="Dettagli Spazio Cloud"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            </DockPanel>
                            <TextBox x:Name="CloudQuotaTextBox"
                                     Style="{StaticResource LogTextBoxStyle}"
                                     MinHeight="80"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="Effettua il login per caricare lo spazio iCloud."
                                     ToolTip="Quota iCloud (getQuotaInfo, storageUsageInfo, storageUsageDetails) — solo lettura."/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Background="#CCFFFFFF"
                BorderBrush="#1A1B1C1F"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <TextBlock Text="Copyright Giordano Sconti Forensis-Lab Development &amp; Research Sector 2026"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="11.5"
                       Foreground="{StaticResource MutedInkBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
