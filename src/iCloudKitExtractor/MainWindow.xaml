                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,8"
                                           Text="iCloud Mail via IMAP (read-only)"/>
