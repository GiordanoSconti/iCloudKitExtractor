<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>iCloudKitExtractor.OctagonJoin</RootNamespace>
    <AssemblyName>OctagonJoin</AssemblyName>
    <Description>Standalone Octagon joinWithVoucher — enroll a new peer using sponsor keys from IKE.</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/._*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\iCloudKitExtractor.Core\iCloudKitExtractor.Core.csproj" />
  </ItemGroup>

</Project>
