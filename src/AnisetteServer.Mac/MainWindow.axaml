<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="using:System"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="720"
        x:Class="AnisetteServer.Mac.MainWindow"
        Width="980" Height="720"
        MinWidth="820" MinHeight="560"
        Title="Forensis-Lab — Anisette Middleware (Windows / macOS)">
  <Grid RowDefinitions="Auto,*" Margin="16">
    <StackPanel Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="Anisette Middleware" FontSize="22" FontWeight="Bold"/>
      <TextBlock Text="Windows &amp; macOS · Frida → jailbroken iPhone · Package-C · HTTP/HTTPS"
                 Opacity="0.7"/>
      <TextBlock x:Name="StatusText" Text="Stopped" Margin="0,6,0,0" FontWeight="SemiBold"/>
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="Server">
        <ScrollViewer>
          <StackPanel Margin="0,12,0,0" Spacing="10" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Frida host (iPhone IP:27042)" FontWeight="SemiBold"/>
            <TextBox x:Name="FridaHostBox" PlaceholderText="192.168.x.y:27042"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="Process" FontWeight="SemiBold"/>
                <TextBox x:Name="FridaProcessBox" Text="akd"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Python" FontWeight="SemiBold"/>
                <TextBox x:Name="PythonBox" Text="python3"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="fetch_anisette.py (optional path / ios_akd_probe dir)" FontWeight="SemiBold"/>
            <TextBox x:Name="FetchScriptBox" PlaceholderText="leave empty = bundled ios_akd_probe"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="Timeout (sec)" FontWeight="SemiBold"/>
                <NumericUpDown x:Name="TimeoutBox" Minimum="10" Maximum="300" Value="60"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                <CheckBox x:Name="LiteCheck" Content="Lite attach" IsChecked="True"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Listen URLs" FontWeight="SemiBold"/>
            <TextBox x:Name="ListenBox" Text="http://0.0.0.0:6971"/>
            <TextBlock Text="Default HTTP (no certs). For HTTPS use https://0.0.0.0:6971 — cert auto-created in data/tls/ (or ANISETTE_TLS_PFX / CERT+KEY)."
                       Opacity="0.65" TextWrapping="Wrap" FontSize="12"/>

            <TextBlock Text="Data root (keys + SQLite; tls/ only if HTTPS)" FontWeight="SemiBold"/>
            <TextBox x:Name="DataRootBox" IsReadOnly="True"/>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
              <Button x:Name="StartBtn" Content="Start server" Click="StartBtn_OnClick" Padding="16,8"/>
              <Button x:Name="StopBtn" Content="Stop" Click="StopBtn_OnClick" Padding="16,8" IsEnabled="False"/>
              <Button Content="Save config" Click="SaveBtn_OnClick" Padding="16,8"/>
            </StackPanel>

            <TextBlock x:Name="MintText" Text="" Opacity="0.75" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Licenses">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Refresh" Click="RefreshLicenses_OnClick" Padding="12,6"/>
              <Button Content="Disable" Click="DisableLicense_OnClick" Padding="12,6"/>
              <Button Content="Enable" Click="EnableLicense_OnClick" Padding="12,6"/>
              <Button Content="Remove" Click="DeleteLicense_OnClick" Padding="12,6"/>
            </StackPanel>
            <TextBlock x:Name="LicenseDbHint" Opacity="0.65" TextWrapping="Wrap" FontSize="12"
                       Text="License DB: (not loaded)"/>
          </StackPanel>

          <ListBox Grid.Row="1" x:Name="LicenseList"
                   Margin="0,10,0,10"
                   SelectionMode="Single">
            <!-- Compiled bindings need an explicit String DataType or the list renders empty on Windows. -->
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="2" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
            <StackPanel Spacing="8">
              <TextBlock Text="Add manual license" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8">
                <TextBox x:Name="ManualSubBox" PlaceholderText="subject / email"/>
                <TextBox Grid.Column="1" x:Name="ManualFpBox" PlaceholderText="fingerprint (optional)"/>
                <NumericUpDown Grid.Column="2" x:Name="ManualDaysBox" Minimum="0" Maximum="3650" Value="30"
                               ToolTip.Tip="0 = no expiry" Width="100"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Issue Package C" Click="IssueManual_OnClick" Padding="12,6"/>
                <TextBox x:Name="IssuedBundleBox" IsReadOnly="True" Width="420" PlaceholderText="issued bundle Base64"/>
                <Button Content="Copy" Click="CopyBundle_OnClick" Padding="12,6"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Connections">
        <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Refresh" Click="RefreshConnections_OnClick" Padding="12,6"/>
              <Button Content="Clear" Click="ClearConnections_OnClick" Padding="12,6"/>
              <CheckBox x:Name="AutoRefreshConnectionsCheck" Content="Auto-refresh" IsChecked="True"
                        VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Opacity="0.65" TextWrapping="Wrap" FontSize="12"
                       Text="Headers · VPN hints · abuse &gt;10/10s → 429. VPN non in allowlist → 403 vpn_consent_required. Loopback/health senza gate."/>
            <TextBlock x:Name="ConnectionLogHint" Opacity="0.75" FontSize="12" Text="0 events"/>
          </StackPanel>

          <ListBox Grid.Row="1" x:Name="ConnectionList"
                   Margin="0,10,0,8"
                   SelectionMode="Single"
                   SelectionChanged="ConnectionList_OnSelectionChanged"
                   PointerPressed="ConnectionList_OnPointerPressed">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           FontFamily="Consolas,Menlo,monospace" FontSize="12"
                           Text="{Binding}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="2" x:Name="ConnectionDetailPanel" IsVisible="False"
                  Margin="0,0,0,8" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6"
                  Padding="8,6" MaxHeight="180">
            <Grid RowDefinitions="Auto,*">
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Dettaglio headers" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Chiudi"
                        Click="CollapseConnectionDetail_OnClick"
                        Padding="10,3" HorizontalAlignment="Right"
                        ToolTip.Tip="Comprime il dettaglio (o clicca di nuovo la riga selezionata)"/>
              </DockPanel>
              <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="ConnectionSelectedDetail"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas,Menlo,monospace"
                         FontSize="11"
                         BorderThickness="0"
                         Background="Transparent"/>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Row="3" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
            <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto,*">
              <TextBlock FontWeight="SemiBold" Text="VPN consent (manual allowlist)"/>
              <CheckBox Grid.Column="0" Grid.Row="1" x:Name="RequireVpnConsentCheck"
                        Content="Require consent for VPN/proxy-like clients"
                        IsChecked="True" Margin="0,6,0,6"
                        Click="RequireVpnConsent_OnClick"/>
              <StackPanel Grid.Column="0" Grid.Row="2" Spacing="6">
                <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                           Text="vpn= shows tipo (proxy/host/unknown) + identity. Allowlist the identity (hostname/provider) or the client IP — not the tipo word. Matching uses extracted identity (and parent domain). Generic tokens proxy/vpn/host/unknown are rejected."/>
                <TextBox x:Name="VpnAllowBox" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="90" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                         PlaceholderText="mullvad&#x0a;203.0.113.10&#x0a;# uni-kassel egress IP — one per line"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Save allowlist" Click="SaveVpnAllow_OnClick" Padding="12,6"/>
                  <Button Content="Allow selected (name)" Click="AllowSelectedVpn_OnClick" Padding="12,6"
                          ToolTip.Tip="Allow suggested provider name when specific; otherwise IP"/>
                  <Button Content="Allow selected IP" Click="AllowSelectedVpnIp_OnClick" Padding="12,6"
                          ToolTip.Tip="Allow only this client IP (safe for shared proxy labels)"/>
                </StackPanel>
              </StackPanel>
              <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="3" RowDefinitions="Auto,*,Auto" MinHeight="200">
                <DockPanel>
                  <TextBlock FontWeight="SemiBold" Text="Pending (denied)" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Content="Clear" Click="ClearVpnPending_OnClick"
                          Padding="10,4" HorizontalAlignment="Right"/>
                </DockPanel>
                <!-- MaxHeight obbligatorio: in StackPanel/Auto il ListBox cresce all'infinito e non scrolla. -->
                <ListBox Grid.Row="1" x:Name="VpnPendingList"
                         MinHeight="120" MaxHeight="260"
                         Margin="0,6,0,6"
                         SelectionMode="Single"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.AllowAutoHide="False">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                      <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                 TextWrapping="Wrap"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                  <Button Content="Allow pending (name)" Click="AllowPendingVpn_OnClick" Padding="12,6"
                          ToolTip.Tip="Allow suggested provider pattern"/>
                  <Button Content="Allow pending IP" Click="AllowPendingVpnIp_OnClick" Padding="12,6"
                          ToolTip.Tip="Allow only the pending client IP"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
