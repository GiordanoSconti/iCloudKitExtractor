<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="iCloudKitExtractor.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#E6FFFFFF"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BoxShadow" Value="0 8 24 0 #1A000000"/>
    </Style>

    <Style Selector="Border.section">
      <Setter Property="Background" Value="#CCFFFFFF"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#22000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>

    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#5F6368"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#202124"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#5F6368"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
    </Style>

    <Style Selector="TextBox.log">
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="FontFamily" Value="Menlo, Consolas, monospace"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="96"/>
      <Setter Property="Background" Value="#0F172A0A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="(ScrollViewer.VerticalScrollBarVisibility)" Value="Auto"/>
      <Setter Property="(ScrollViewer.HorizontalScrollBarVisibility)" Value="Auto"/>
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#5F6368"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.logCard">
      <Setter Property="Background" Value="#CCFFFFFF"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#22000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="Border.sessionChip">
      <Setter Property="Background" Value="#F1F6FE"/>
      <Setter Property="BorderBrush" Value="#D2E3FC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="12,6"/>
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#4285F4"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#4285F4"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
  </Application.Styles>
</Application>
