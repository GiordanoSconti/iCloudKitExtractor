<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AnisetteServer</AssemblyName>
    <RootNamespace>iCloudKitExtractor.AnisetteServer</RootNamespace>
    <SupportedOSPlatformVersion>10.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);ANISETTE_SERVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\iCloudKitExtractor.Core\Protocol\AppleXmlPlist.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Models\AnisetteHeaders.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Http\AppleClientInfo.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Http\AkdHttpHeaders.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Http\AppleCertificateTrust.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\AdiDeviceProfile.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\GrandSlamCpdBuilder.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\AnisetteDeviceStore.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\AppleRuntimeLocator.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\CoreAdiBridgeClient.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\AdiProvisioningService.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\IAnisetteProvider.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\AnisetteFetchOptions.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\CoreAdiAnisetteProvider.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\IAdiCryptoClient.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\HttpAdiCryptoClient.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\EmulatedAkdAnisetteProvider.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\FridaIphoneAnisetteProvider.cs" LinkBase="Shared" />
    <Compile Include="..\iCloudKitExtractor.Core\Services\Auth\FridaAnisetteOptions.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\iCloudKitExtractor.Core\Assets\certs\AppleServerAuthenticationCA.der" Link="Assets\certs\AppleServerAuthenticationCA.der" />
    <EmbeddedResource Include="..\iCloudKitExtractor.Core\Assets\certs\AppleRootCA.cer" Link="Assets\certs\AppleRootCA.cer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\native\CoreAdiBridge\out\CoreAdiBridge.exe" Link="CoreAdiBridge.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\native\CoreAdiBridge\out\CoreAdiBridge.exe')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\scripts\ios_akd_probe\**\*"
          Link="ios_akd_probe\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
