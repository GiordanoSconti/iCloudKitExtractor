# Copy to wrangler.toml and fill in the KV namespace id (never commit wrangler.toml).
#
#   copy wrangler.toml.example wrangler.toml
#   npx wrangler kv namespace create ANISETTE_LICENSE_KV
#   npx wrangler secret put ANISETTE_LICENSE_SYNC_SECRET
#   npx wrangler deploy
#
# Route: www.icloudkitextractor.eu/internal/license*

name = "anisette-license-hub"
main = "src/worker.js"
compatibility_date = "2025-11-01"

[[kv_namespaces]]
binding = "LICENSES"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[vars]
REPLICA_ID = "license-hub"
