<Project>
  <!-- MimeKit still pulls Pkcs 10.0.0 (GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7).
       Pin only on Core: app TFMs (net10.0-windows) treat Pkcs as inbox and warn NU1510. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'iCloudKitExtractor.Core'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
</Project>
