<Project>
  <!-- MimeKit 4.x still declares Pkcs 10.0.0 (GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'iCloudKitExtractor.Core' OR '$(MSBuildProjectName)' == 'iCloudKitExtractor' OR '$(MSBuildProjectName)' == 'iCloudKitExtractor.Desktop'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
</Project>
